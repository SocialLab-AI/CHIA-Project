{
  "schema_version": "1.0",
  "experiment_id": "baseline",
  "software": {
    "model": {
      "family": "llama3.1",
      "variant": "8b",
      "runtime": "ollama"
    },
    "prompt": {
      "system_prompt_file": "prompts/tutor_system.txt"
    },
    "inference": {
      "temperature": 0.2,
      "top_p": 0.9,
      "max_new_tokens": 256,
      "context_window": 4096,
      "seed": 42,
      "threads": 4,
      "batch_size": 1
    }
  },
  "hardware": {
    "simulator": "gem5",
    "proxy_workload": {
      "name": "attention_kernel",
      "sequence_length": 128,
      "head_dim": 64,
      "num_heads": 8,
      "dtype": "fp32"
    },
    "cpu": {
      "model": "O3CPU",
      "cores": 1,
      "clock_ghz": 2.0,
      "issue_width": 4
    },
    "caches": {
      "l1i_kib": 32,
      "l1d_kib": 32,
      "l2_kib": 512,
      "line_bytes": 64
    },
    "memory": {
      "size_mib": 2048
    }
  },
  "evaluation": {
    "questions_file": "data/questions/questions.json",
    "references_file": "data/references/openstax.json",
    "reference_source": "openstax",
    "reference_visible_to_model": false,
    "comparison_method": "semantic_similarity",
    "sample_limit": 50
  },
  "metadata": {
    "description": "Baseline co-design experiment for the Llama tutor and gem5 attention-kernel proxy.",
    "tags": [
      "baseline",
      "llama3.1",
      "gem5",
      "attention-kernel"
    ]
  }
}
