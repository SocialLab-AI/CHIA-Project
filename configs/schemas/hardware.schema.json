{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hardware.schema.json",
  "title": "CHIA gem5 Hardware Configuration",
  "description": "Canonical hardware-side configuration for the attention-kernel proxy workload simulated in gem5.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "simulator",
    "proxy_workload",
    "cpu",
    "caches",
    "memory"
  ],
  "properties": {
    "simulator": {
      "type": "string",
      "const": "gem5"
    },
    "proxy_workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sequence_length",
        "head_dim",
        "num_heads",
        "dtype"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "attention_kernel"
        },
        "sequence_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "head_dim": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "num_heads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "dtype": {
          "type": "string",
          "enum": [
            "fp32",
            "fp16",
            "bf16",
            "int8"
          ]
        }
      }
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "cores",
        "clock_ghz",
        "issue_width"
      ],
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "O3CPU",
            "TimingSimpleCPU",
            "MinorCPU",
            "other"
          ]
        },
        "cores": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "clock_ghz": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 10.0
        },
        "issue_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "Meaningful primarily for an out-of-order CPU model such as O3CPU."
        }
      }
    },
    "caches": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "l1i_kib",
        "l1d_kib",
        "l2_kib",
        "line_bytes"
      ],
      "properties": {
        "l1i_kib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "l1d_kib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "l2_kib": {
          "type": "integer",
          "minimum": 16,
          "maximum": 65536
        },
        "line_bytes": {
          "type": "integer",
          "enum": [
            32,
            64,
            128
          ]
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_mib"
      ],
      "properties": {
        "size_mib": {
          "type": "integer",
          "minimum": 128,
          "maximum": 1048576
        }
      }
    }
  }
}
