{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment.schema.json",
  "title": "CHIA Experiment Configuration",
  "description": "One complete co-design experiment: tutor software configuration + gem5 hardware configuration + evaluation setup.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "software",
    "hardware",
    "evaluation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "software": {
      "$ref": "software.schema.json"
    },
    "hardware": {
      "$ref": "hardware.schema.json"
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questions_file",
        "references_file",
        "reference_source",
        "reference_visible_to_model",
        "comparison_method"
      ],
      "properties": {
        "questions_file": {
          "type": "string",
          "minLength": 1
        },
        "references_file": {
          "type": "string",
          "minLength": 1
        },
        "reference_source": {
          "type": "string",
          "const": "openstax"
        },
        "reference_visible_to_model": {
          "type": "boolean",
          "const": false,
          "description": "Hard guardrail: OpenStax references are evaluation-only."
        },
        "comparison_method": {
          "type": "string",
          "enum": [
            "exact_match",
            "token_f1",
            "semantic_similarity",
            "llm_judge",
            "custom"
          ]
        },
        "sample_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
