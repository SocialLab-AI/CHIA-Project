{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_record.schema.json",
  "title": "CHIA Experiment Run Record",
  "description": "Structured record produced after executing a configured tutor + hardware experiment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "status",
    "started_at",
    "finished_at",
    "config_snapshot"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "partial"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "config_snapshot": {
      "$ref": "experiment.schema.json"
    },
    "software_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_count",
        "quality",
        "performance"
      ],
      "properties": {
        "question_count": {
          "type": "integer",
          "minimum": 0
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "score"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "score": {
              "type": "number"
            }
          }
        },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mean_latency_ms": {
              "type": "number",
              "minimum": 0
            },
            "p95_latency_ms": {
              "type": "number",
              "minimum": 0
            },
            "tokens_per_second": {
              "type": "number",
              "minimum": 0
            },
            "peak_rss_mb": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "hardware_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sim_ticks": {
          "type": "integer",
          "minimum": 0
        },
        "num_cycles": {
          "type": "number",
          "minimum": 0
        },
        "ipc": {
          "type": "number",
          "minimum": 0
        },
        "l1d_miss_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "l1i_miss_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "l2_miss_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "energy_mj": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "required": [
          "software_result",
          "hardware_result"
        ]
      }
    }
  ]
}
