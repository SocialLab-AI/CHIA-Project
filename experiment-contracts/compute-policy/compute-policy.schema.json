{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/chia/compute-policy.schema.json",
  "title": "CHIA Progressive Compute Policy",
  "description": "Small operational policy: allowed real execution backends, parallelism, Gemini use, and organizer-burst access by tier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "gemini",
    "tiers"
  ],
  "properties": {
    "policy_version": {
      "const": "0.2.0"
    },
    "gemini": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_usd",
        "metering_required"
      ],
      "properties": {
        "budget_usd": {
          "type": "number",
          "minimum": 0
        },
        "metering_required": {
          "type": "boolean"
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "integration",
        "pilot",
        "final"
      ],
      "properties": {
        "dev": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backends",
            "max_parallel_jobs",
            "gemini_allowed",
            "organizer_burst_allowed"
          ],
          "properties": {
            "backends": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "local",
                  "contabo",
                  "development_cloud",
                  "organizer_burst"
                ]
              }
            },
            "max_parallel_jobs": {
              "type": "integer",
              "minimum": 1
            },
            "gemini_allowed": {
              "type": "boolean"
            },
            "organizer_burst_allowed": {
              "type": "boolean"
            }
          }
        },
        "integration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backends",
            "max_parallel_jobs",
            "gemini_allowed",
            "organizer_burst_allowed"
          ],
          "properties": {
            "backends": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "local",
                  "contabo",
                  "development_cloud",
                  "organizer_burst"
                ]
              }
            },
            "max_parallel_jobs": {
              "type": "integer",
              "minimum": 1
            },
            "gemini_allowed": {
              "type": "boolean"
            },
            "organizer_burst_allowed": {
              "type": "boolean"
            }
          }
        },
        "pilot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backends",
            "max_parallel_jobs",
            "gemini_allowed",
            "organizer_burst_allowed"
          ],
          "properties": {
            "backends": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "local",
                  "contabo",
                  "development_cloud",
                  "organizer_burst"
                ]
              }
            },
            "max_parallel_jobs": {
              "type": "integer",
              "minimum": 1
            },
            "gemini_allowed": {
              "type": "boolean"
            },
            "organizer_burst_allowed": {
              "type": "boolean"
            }
          }
        },
        "final": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backends",
            "max_parallel_jobs",
            "gemini_allowed",
            "organizer_burst_allowed"
          ],
          "properties": {
            "backends": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "local",
                  "contabo",
                  "development_cloud",
                  "organizer_burst"
                ]
              }
            },
            "max_parallel_jobs": {
              "type": "integer",
              "minimum": 1
            },
            "gemini_allowed": {
              "type": "boolean"
            },
            "organizer_burst_allowed": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
