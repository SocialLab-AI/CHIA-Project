{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CHIA Attention Kernel Experiment",
  "description": "One concrete attention-kernel and gem5 experiment. Inputs describe the simulated target; metrics are emitted by the gem5 metrics interface.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "workload", "software", "hardware", "measurement", "metrics", "status"],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_id", "campaign_id", "description"],
      "properties": {
        "experiment_id": { "type": "string", "minLength": 1 },
        "campaign_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_tokens", "query_heads", "kv_heads", "head_dimension", "layers"],
      "properties": {
        "context_tokens": { "type": "integer", "enum": [128, 256, 512, 1024, 2048, 4096] },
        "query_heads": { "type": "integer", "minimum": 1 },
        "kv_heads": { "type": "integer", "minimum": 1 },
        "head_dimension": { "type": "integer", "minimum": 1 },
        "layers": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "kv_format", "threads"],
      "properties": {
        "implementation": { "const": "AttentionKernelQuantizedKV" },
        "kv_format": {
          "type": "string",
          "enum": ["FP32", "Q4"],
          "description": "Validated KV-cache formats. FP16 and Q8 remain future candidates."
        },
        "threads": {
          "type": "integer",
          "enum": [1, 2, 4],
          "description": "Software threads. The runner must reject values greater than hardware.cores."
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_model", "cores", "frequency_ghz", "issue_width", "l1i_cache_kib", "l1i_associativity", "l1i_latency_cycles", "l1d_cache_kib", "l1d_associativity", "l1d_latency_cycles", "l2_cache_kib", "l2_associativity", "l2_latency_cycles", "memory_type", "memory_size_mib", "simulation_mode"],
      "properties": {
        "cpu_model": { "type": "string", "enum": ["RiscvTimingSimpleCPU", "RiscvO3CPU"], "default": "RiscvO3CPU" },
        "cores": { "type": "integer", "enum": [1, 2, 4], "default": 2 },
        "frequency_ghz": { "type": "integer", "enum": [1, 2, 3, 4], "default": 1 },
        "issue_width": { "type": "integer", "enum": [1, 2, 4], "default": 2, "description": "RiscvTimingSimpleCPU is constrained to issue width 1." },
        "l1i_cache_kib": { "const": 16 },
        "l1i_associativity": { "const": 2 },
        "l1i_latency_cycles": { "const": 2 },
        "l1d_cache_kib": { "type": "integer", "enum": [16, 32, 64], "default": 64 },
        "l1d_associativity": { "type": "integer", "enum": [2, 4, 8], "default": 4 },
        "l1d_latency_cycles": { "const": 2 },
        "l2_cache_kib": { "type": "integer", "enum": [256, 512, 1024], "default": 1024 },
        "l2_associativity": { "type": "integer", "enum": [4, 8, 16], "default": 8 },
        "l2_latency_cycles": { "const": 20 },
        "memory_type": { "const": "DDR3_1600_8x8" },
        "memory_size_mib": { "const": 16 },
        "simulation_mode": { "const": "SE" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitions", "warmup_runs", "max_simulation_instructions"],
      "properties": {
        "repetitions": { "type": "integer", "minimum": 1 },
        "warmup_runs": { "type": "integer", "minimum": 0 },
        "max_simulation_instructions": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "metrics": { "$ref": "#/$defs/gem5_metrics" },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "message"],
      "properties": {
        "state": { "type": "string", "enum": ["planned", "validated", "running", "completed", "failed", "rejected"] },
        "message": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "nullable_nonnegative_number": { "type": ["number", "null"], "minimum": 0 },
    "nullable_nonnegative_integer": { "type": ["integer", "null"], "minimum": 0 },
    "nullable_number_array": { "oneOf": [{ "type": "null" }, { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0 } }] },
    "nullable_integer_array": { "oneOf": [{ "type": "null" }, { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } }] },
    "gem5_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sim_ticks", "simulated_seconds", "latency_ms", "host_seconds", "instructions", "cycles_per_core", "cpi_per_core", "ipc_per_core", "aggregate_ipc", "l1i_miss_rate_per_core", "l1d_miss_rate_per_core", "l2_miss_rate", "dram_bytes_read", "dram_bytes_written", "dram_bandwidth_bytes_per_second", "dram_bandwidth_utilization_percent", "average_dram_access_latency_ns"],
      "properties": {
        "sim_ticks": { "$ref": "#/$defs/nullable_nonnegative_integer" },
        "simulated_seconds": { "$ref": "#/$defs/nullable_nonnegative_number" },
        "latency_ms": { "$ref": "#/$defs/nullable_nonnegative_number" },
        "host_seconds": { "$ref": "#/$defs/nullable_nonnegative_number" },
        "instructions": { "$ref": "#/$defs/nullable_nonnegative_integer" },
        "cycles_per_core": { "$ref": "#/$defs/nullable_integer_array" },
        "cpi_per_core": { "$ref": "#/$defs/nullable_number_array" },
        "ipc_per_core": { "$ref": "#/$defs/nullable_number_array" },
        "aggregate_ipc": { "$ref": "#/$defs/nullable_nonnegative_number" },
        "l1i_miss_rate_per_core": { "$ref": "#/$defs/nullable_number_array" },
        "l1d_miss_rate_per_core": { "$ref": "#/$defs/nullable_number_array" },
        "l2_miss_rate": { "$ref": "#/$defs/nullable_nonnegative_number" },
        "dram_bytes_read": { "$ref": "#/$defs/nullable_nonnegative_integer" },
        "dram_bytes_written": { "$ref": "#/$defs/nullable_nonnegative_integer" },
        "dram_bandwidth_bytes_per_second": { "$ref": "#/$defs/nullable_nonnegative_number" },
        "dram_bandwidth_utilization_percent": { "$ref": "#/$defs/nullable_nonnegative_number" },
        "average_dram_access_latency_ns": { "$ref": "#/$defs/nullable_nonnegative_number" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "hardware": { "properties": { "cpu_model": { "const": "RiscvTimingSimpleCPU" } }, "required": ["cpu_model"] } } },
      "then": { "properties": { "hardware": { "properties": { "issue_width": { "const": 1 } } } } }
    }
  ]
}