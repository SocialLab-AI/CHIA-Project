{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/chia/attention-experiment.schema.json",
  "title": "CHIA Attention Kernel Experiment",
  "description": "One concrete attention-kernel + gem5 experiment. Hardware configuration delegates to canonical chia-experiment.schema.json, while attention-specific proxy workload controls remain defined here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "workload",
    "software",
    "hardware",
    "measurement",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "campaign_id",
        "description"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_tokens",
        "query_heads",
        "kv_heads",
        "head_dimension",
        "layers"
      ],
      "properties": {
        "context_tokens": {
          "type": "integer",
          "enum": [
            128,
            256,
            512,
            1024,
            2048,
            4096
          ]
        },
        "query_heads": {
          "type": "integer",
          "minimum": 1
        },
        "kv_heads": {
          "type": "integer",
          "minimum": 1
        },
        "head_dimension": {
          "type": "integer",
          "minimum": 1
        },
        "layers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "kv_format",
        "threads"
      ],
      "properties": {
        "implementation": {
          "const": "AttentionKernelQuantizedKV"
        },
        "kv_format": {
          "type": "string",
          "enum": [
            "FP32",
            "Q4"
          ],
          "description": "Validated proxy KV cache numeric format. FP32 and Q4 are currently validated; FP16 and Q8 are planned."
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "hardware": {
      "$ref": "https://example.local/chia/chia-experiment.schema.json#/$defs/hardware_config"
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repetitions",
        "warmup_runs",
        "max_simulation_instructions"
      ],
      "properties": {
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "warmup_runs": {
          "type": "integer",
          "minimum": 0
        },
        "max_simulation_instructions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "message"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "planned",
            "validated",
            "running",
            "completed",
            "failed",
            "rejected"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
