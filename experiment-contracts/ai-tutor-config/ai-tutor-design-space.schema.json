{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/chia/ai-tutor-design-space.schema.json",
  "title": "CHIA AI Tutor Software Design Space",
  "description": "Schema for the AI Tutor software design space, recording the fixed initial baseline and pending software search space.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "description",
    "baseline",
    "fixed",
    "active_candidates",
    "pending_search_space",
    "optimization_metrics",
    "unresolved_runtime_items"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "description": {
      "type": "string"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "quantization",
        "backend",
        "cpu_threads",
        "batch_size",
        "temperature",
        "max_output_tokens",
        "embedding_model",
        "embedding_dimension",
        "retrieval_method",
        "top_k",
        "chunk_size",
        "chunk_overlap",
        "chunk_unit",
        "runtime_ready",
        "status"
      ],
      "properties": {
        "model": { "type": "string" },
        "quantization": { "type": "string" },
        "backend": { "type": "string" },
        "cpu_threads": { "type": "integer", "minimum": 1 },
        "batch_size": { "type": "integer", "minimum": 1 },
        "temperature": { "type": "number", "minimum": 0 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "embedding_model": { "type": "string" },
        "embedding_dimension": { "type": "integer", "minimum": 1 },
        "retrieval_method": { "type": "string" },
        "top_k": { "type": "integer", "minimum": 1 },
        "chunk_size": { "type": "integer", "minimum": 1 },
        "chunk_overlap": { "type": "integer", "minimum": 0 },
        "chunk_unit": { "type": "string", "enum": ["characters"] },
        "runtime_ready": { "type": "boolean" },
        "status": { "type": "string" }
      }
    },
    "fixed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "quantization",
        "backend",
        "cpu_threads",
        "batch_size",
        "temperature",
        "max_output_tokens",
        "embedding_model",
        "embedding_dimension",
        "retrieval_method",
        "top_k",
        "chunk_size",
        "chunk_overlap",
        "chunk_unit"
      ],
      "properties": {
        "model": { "type": "string" },
        "quantization": { "type": "string" },
        "backend": { "type": "string" },
        "cpu_threads": { "type": "integer", "minimum": 1 },
        "batch_size": { "type": "integer", "minimum": 1 },
        "temperature": { "type": "number", "minimum": 0 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "embedding_model": { "type": "string" },
        "embedding_dimension": { "type": "integer", "minimum": 1 },
        "retrieval_method": { "type": "string" },
        "top_k": { "type": "integer", "minimum": 1 },
        "chunk_size": { "type": "integer", "minimum": 1 },
        "chunk_overlap": { "type": "integer", "minimum": 0 },
        "chunk_unit": { "type": "string", "enum": ["characters"] }
      }
    },
    "active_candidates": {
      "type": "object"
    },
    "pending_search_space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "description", "knobs"],
      "properties": {
        "status": { "type": "string" },
        "description": { "type": "string" },
        "knobs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status", "intended_purpose"],
            "properties": {
              "name": { "type": "string" },
              "unit": { "type": "string" },
              "status": { "type": "string" },
              "intended_purpose": { "type": "string" }
            }
          }
        }
      }
    },
    "optimization_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer_quality", "latency_ms"],
      "properties": {
        "answer_quality": {
          "type": "object",
          "required": ["direction", "intended_purpose"],
          "properties": {
            "direction": { "const": "maximize" },
            "intended_purpose": { "type": "string" }
          }
        },
        "latency_ms": {
          "type": "object",
          "required": ["direction", "intended_purpose"],
          "properties": {
            "direction": { "const": "minimize" },
            "intended_purpose": { "type": "string" }
          }
        }
      }
    },
    "unresolved_runtime_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
