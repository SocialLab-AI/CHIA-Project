{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/chia/ai-tutor.schema.json",
  "title": "CHIA AI Tutor Application Config",
  "description": "Application-level experiment contract for the offline AI Tutor. Thin compatibility schema referencing canonical software, metrics, and status definitions from chia-experiment.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "workload",
    "software",
    "proxy_evaluation",
    "metrics",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "metadata": {
      "$ref": "https://example.local/chia/chia-experiment.schema.json#/$defs/metadata"
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "corpus_id",
        "evaluation_protocol",
        "num_questions",
        "seed"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_protocol": {
          "type": "string",
          "minLength": 1
        },
        "num_questions": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "software": {
      "$ref": "https://example.local/chia/chia-experiment.schema.json#/$defs/software_config"
    },
    "proxy_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "mapping_id",
        "attention_experiment_ref"
      ],
      "properties": {
        "type": {
          "const": "attention_kernel"
        },
        "mapping_id": {
          "type": "string",
          "minLength": 1
        },
        "attention_experiment_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "metrics": {
      "$ref": "https://example.local/chia/chia-experiment.schema.json#/$defs/metrics"
    },
    "status": {
      "$ref": "https://example.local/chia/chia-experiment.schema.json#/$defs/status"
    }
  }
}
