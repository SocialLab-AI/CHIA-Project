{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/chia/ai-tutor.schema.json",
  "title": "CHIA AI Tutor Application Config",
  "description": "Application-level experiment contract for the offline AI Tutor workload and evaluation controls.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "workload",
    "software",
    "evaluation",
    "proxy_evaluation",
    "metrics",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "description",
        "artifact_manifest"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "artifact_manifest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "corpus_id",
        "evaluation_protocol",
        "num_questions",
        "seed"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_protocol": {
          "type": "string",
          "minLength": 1
        },
        "num_questions": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "quantization",
        "backend",
        "cpu_threads",
        "batch_size",
        "temperature",
        "max_output_tokens",
        "embedding_model",
        "embedding_dimension",
        "retrieval_method",
        "top_k",
        "chunk_size",
        "chunk_overlap",
        "chunk_unit",
        "runtime_ready"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "quantization": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "cpu_threads": {
          "type": "integer",
          "minimum": 1
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "embedding_model": {
          "type": "string",
          "minLength": 1
        },
        "embedding_dimension": {
          "type": "integer",
          "minimum": 1
        },
        "retrieval_method": {
          "type": "string",
          "minLength": 1
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "chunk_size": {
          "type": "integer",
          "minimum": 1
        },
        "chunk_overlap": {
          "type": "integer",
          "minimum": 0
        },
        "chunk_unit": {
          "type": "string",
          "enum": [
            "characters"
          ]
        },
        "runtime_ready": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "unresolved_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_source",
        "reference_visible_to_model"
      ],
      "properties": {
        "questions_file": {
          "type": "string"
        },
        "references_file": {
          "type": "string"
        },
        "reference_source": {
          "type": "string",
          "const": "openstax",
          "description": "Evaluation reference answers source. Hard guardrail: held out for evaluation only."
        },
        "reference_visible_to_model": {
          "type": "boolean",
          "const": false,
          "description": "Hard guardrail: evaluation reference answers must never be visible to the model."
        },
        "comparison_method": {
          "type": "string"
        },
        "sample_limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "proxy_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "mapping_id",
        "attention_experiment_ref"
      ],
      "properties": {
        "type": {
          "const": "attention_kernel"
        },
        "mapping_id": {
          "type": "string",
          "minLength": 1
        },
        "attention_experiment_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application"
      ],
      "properties": {
        "application": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer_quality",
            "latency_ms",
            "memory_mb",
            "throughput_qps"
          ],
          "properties": {
            "answer_quality": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "latency_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "memory_mb": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "throughput_qps": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "message"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "planned",
            "validated",
            "running",
            "completed",
            "failed",
            "rejected"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
